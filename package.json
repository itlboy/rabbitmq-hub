{
  "name": "rabbitmq-hub",
  "version": "1.6.3",
  "description": "One dashboard for several RabbitMQ clusters, behind Cloudflare Access.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "dev:mock": "VITE_MOCK=1 vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "build:mock": "VITE_MOCK=1 vite build --config web/vite.config.js --outDir ../dist-mock",
    "start": "node server.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vue": "3.5.44"
  },
  "engines": {
    "node": ">=26"
  }
}
